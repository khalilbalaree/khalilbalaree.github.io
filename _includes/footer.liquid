<footer class="site-footer" role="contentinfo">
  <div class="container">
    <p class="footer-line">
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}.
      {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
      <span class="footer-sep" aria-hidden="true">&middot;</span>
      <a class="footer-top" href="#">Back to top <span aria-hidden="true">&uarr;</span></a>
    </p>
  </div>
</footer>

<script>
  // "Back to top" scrolls smoothly instead of jumping (unless the visitor prefers reduced motion)
  document.querySelector('.footer-top')?.addEventListener('click', (event) => {
    event.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
