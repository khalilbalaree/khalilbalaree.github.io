{% if site.navbar_fixed %}
  <!-- Auto-hiding header: slides away while scrolling down, back on scroll up. Styles live here
       because navbar-hidden is only added at runtime, so PurgeCSS (run on deploy) would strip it. -->
  <style>
    #navbar,
    #progress {
      transition: transform 0.25s ease;
    }
    #navbar.navbar-hidden {
      transform: translateY(-110%);
      box-shadow: none;
    }
    @media (prefers-reduced-motion: reduce) {
      #navbar,
      #progress {
        transition: none;
      }
    }
  </style>

  <script>
    (() => {
      const navbar = document.getElementById('navbar');
      if (!navbar) return;
      const progress = document.getElementById('progress');
      const menu = document.getElementById('navbarNav');
      const threshold = 6;
      let lastY = window.scrollY;
      let hidden = false;
      let ticking = false;

      const setHidden = (hide) => {
        if (hide === hidden) return;
        hidden = hide;
        navbar.classList.toggle('navbar-hidden', hide);
        // Keep the reading-progress line at the top edge instead of floating where the bar was
        if (progress) progress.style.transform = hide ? `translateY(-${navbar.offsetHeight}px)` : '';
      };

      const update = () => {
        ticking = false;
        const y = window.scrollY;
        const menuOpen = menu && menu.classList.contains('show');
        if (y <= navbar.offsetHeight || menuOpen || navbar.contains(document.activeElement)) {
          setHidden(false);
          lastY = y;
        } else if (y - lastY > threshold) {
          setHidden(true);
          lastY = y;
        } else if (lastY - y > threshold) {
          setHidden(false);
          lastY = y;
        }
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      // Tabbing into a hidden bar brings it back
      navbar.addEventListener('focusin', () => setHidden(false));
    })();
  </script>
{% endif %}
